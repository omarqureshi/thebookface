<% content_for :title, "Edit your profile" %>

<div class="feed">
  <%= link_to "← Back to your profile", profile_path, class: "backlink" %>

  <div class="card">
    <h2 class="thread__title">Edit your profile</h2>

    <%= form_with model: @profile, url: profile_path, method: :patch do |f| %>
      <% if @profile.errors.any? %>
        <div class="flash flash--alert"><%= @profile.errors.full_messages.to_sentence %></div>
      <% end %>

      <label class="field">
        <span class="field__label">Display name</span>
        <%= f.text_field :display_name, class: "composer__input", placeholder: current_user.name %>
      </label>

      <label class="field">
        <span class="field__label">Bio</span>
        <%= f.text_area :bio, rows: 4, class: "composer__input",
              placeholder: "Tell people a little about yourself…" %>
      </label>

      <div class="composer__actions">
        <%= link_to "Cancel", profile_path, class: "btn btn--ghost" %>
        <%= f.submit "Save", class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</div>
