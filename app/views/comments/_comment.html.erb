<%# One comment in the thread. Indentation comes straight from `depth` (the number
    of segments in the materialized path), so the flat pre-ordered array renders as
    a tree with no recursion. Depth is capped so very deep replies stay on screen.
    A soft-deleted comment (one that still has replies) renders as a tombstone so
    the subtree stays threaded. %>
<% indent = [comment.depth, 8].min %>
<div class="comment" id="<%= comment.anchor %>" style="--indent: <%= indent %>">
  <% if comment.deleted? %>
    <span class="avatar avatar--sm avatar--ghost">×</span>
    <div class="comment__body">
      <div class="comment__bubble comment__bubble--deleted"><span class="muted">[comment deleted]</span></div>
    </div>
  <% else %>
    <span class="avatar avatar--sm"><%= comment.author.initials %></span>
    <div class="comment__body">
      <div class="comment__bubble">
        <span class="comment__author"><%= comment.author.name %></span>
        <div class="comment__text"><%= simple_format(comment.body) %></div>
      </div>

      <div class="comment__meta">
        <span class="comment__time"><%= time_ago_in_words(comment.created_at) %> ago</span>
        <% if can? :update, comment %>
          <%# Edit sits inline with Delete; its form drops in full-width below. %>
          <details class="comment-edit">
            <summary class="comment__action">Edit</summary>
            <%= form_with model: comment, url: post_comment_path(post, comment), method: :patch, class: "comment-form" do |f| %>
              <%= f.text_area :body, rows: 2, class: "comment-form__input", "aria-label": "Edit comment" %>
              <div class="comment-form__actions">
                <%= f.submit "Save", class: "btn btn--primary btn--sm" %>
              </div>
            <% end %>
          </details>
        <% end %>
        <% if can? :destroy, comment %>
          <%= button_to "Delete", post_comment_path(post, comment), method: :delete,
                class: "comment__action comment__action--danger",
                form_class: "comment__action-form",
                data: { turbo_confirm: "Delete this comment?" } %>
        <% end %>
      </div>

      <% if signed_in? %>
        <details class="reply">
          <summary class="reply__toggle">Reply</summary>
          <%= render "comments/form",
                post: post,
                parent_path: comment.path,
                label: "Reply to #{comment.author.name}…" %>
        </details>
      <% end %>

      <%= render "reactions/bar", post: post, subject: comment,
            mine: local_assigns[:my_reactions]&.dig(comment.reaction_target) %>
    </div>
  <% end %>
</div>
