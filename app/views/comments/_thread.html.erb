<%# A post's comment thread, wrapped in a Turbo Frame so the feed can load it
    inline (by pulling this same frame out of the post page) and so posting a
    comment/reply updates it in place. The new-comment form sits BELOW the list. %>
<%= turbo_frame_tag "post_#{post.id}_comments" do %>
  <div class="thread__list">
    <% if comments.empty? %>
      <p class="muted">No comments yet — start the thread.</p>
    <% else %>
      <% comments.each do |comment| %>
        <%= render "comments/comment", comment: comment, post: post, my_reactions: my_reactions %>
      <% end %>
    <% end %>
  </div>

  <% if signed_in? %>
    <%= render "comments/form", post: post, parent_path: nil, label: "Comment on this post…" %>
  <% else %>
    <p class="muted">Sign in with Google to join the conversation.</p>
  <% end %>
<% end %>
